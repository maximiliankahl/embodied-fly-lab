# Copy this file to .env and fill in your values. .env is never committed.
ANTHROPIC_API_KEY=
# Optional: another model, e.g. claude-sonnet-5-5 (faster, cheaper)
ANTHROPIC_MODEL=claude-opus-5-5
# Only needed if your API key is NOT scoped to a workspace (Console > Settings > Workspaces > ID, starts with wrkspc_)
ANTHROPIC_WORKSPACE_ID=
